{
  "$defs": {
    "animationItem": {
      "allOf": [
        {
          "$ref": "#/$defs/itemBase"
        },
        {
          "properties": {
            "item_type": {
              "const": "animation"
            },
            "path": {
              "description": "Path to the payload file, absolute or relative to the document. Accepted extensions (case-insensitive): .mp4. Checked by the backend when the item is saved.",
              "type": "string"
            }
          },
          "required": [
            "item_type"
          ]
        }
      ]
    },
    "fileItem": {
      "allOf": [
        {
          "$ref": "#/$defs/itemBase"
        },
        {
          "properties": {
            "item_type": {
              "const": "file"
            },
            "path": {
              "description": "Path to the payload file, absolute or relative to the document. Checked by the backend when the item is saved.",
              "type": "string"
            }
          },
          "required": [
            "item_type"
          ]
        }
      ]
    },
    "htmlItem": {
      "allOf": [
        {
          "$ref": "#/$defs/itemBase"
        },
        {
          "properties": {
            "item_type": {
              "const": "html"
            },
            "value": {
              "description": "Inline text or HTML payload, checked by the backend during item creation.",
              "type": [
                "string",
                "number",
                "boolean",
                "null",
                "array",
                "object"
              ]
            }
          },
          "required": [
            "item_type"
          ]
        }
      ]
    },
    "imageItem": {
      "allOf": [
        {
          "$ref": "#/$defs/itemBase"
        },
        {
          "properties": {
            "item_type": {
              "const": "image"
            },
            "path": {
              "description": "Path to the payload file, absolute or relative to the document. Accepted extensions (case-insensitive): .png, .jpg, .tif, .tiff. Checked by the backend when the item is saved.",
              "type": "string"
            }
          },
          "required": [
            "item_type"
          ]
        }
      ]
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/textItem"
        },
        {
          "$ref": "#/$defs/htmlItem"
        },
        {
          "$ref": "#/$defs/tableItem"
        },
        {
          "$ref": "#/$defs/treeItem"
        },
        {
          "$ref": "#/$defs/imageItem"
        },
        {
          "$ref": "#/$defs/animationItem"
        },
        {
          "$ref": "#/$defs/sceneItem"
        },
        {
          "$ref": "#/$defs/fileItem"
        }
      ]
    },
    "itemBase": {
      "additionalProperties": true,
      "properties": {
        "item_type": {
          "type": "string"
        },
        "name": {
          "description": "Item name.",
          "minLength": 1,
          "type": "string"
        },
        "sequence": {
          "description": "Ordering hint within a report.",
          "type": "integer"
        },
        "source": {
          "description": "Producing application or component.",
          "type": "string"
        },
        "tags": {
          "description": "Tags applied to this object. Checked by the backend when each item is created.",
          "items": {
            "$ref": "#/$defs/tagObject"
          },
          "type": "array"
        }
      },
      "required": [
        "item_type",
        "name"
      ],
      "type": "object"
    },
    "sceneItem": {
      "allOf": [
        {
          "$ref": "#/$defs/itemBase"
        },
        {
          "properties": {
            "item_type": {
              "const": "scene"
            },
            "path": {
              "description": "Path to the payload file, absolute or relative to the document. Accepted extensions (case-insensitive): .stl, .ply, .csf, .avz, .scdoc, .scdocx, .dsco, .glb, .obj. Checked by the backend when the item is saved.",
              "type": "string"
            }
          },
          "required": [
            "item_type"
          ]
        }
      ]
    },
