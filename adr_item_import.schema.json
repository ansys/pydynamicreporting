            "zaxis_tick_delta": {
              "description": "ADR table property, passed to the backend unchanged.",
              "type": [
                "string",
                "number",
                "boolean",
                "null",
                "array",
                "object"
              ]
            },
            "zrange": {
              "description": "ADR table property, passed to the backend unchanged.",
              "type": [
                "string",
                "number",
                "boolean",
                "null",
                "array",
                "object"
              ]
            },
            "ztitle": {
              "description": "ADR table property, passed to the backend unchanged.",
              "type": [
                "string",
                "number",
                "boolean",
                "null",
                "array",
                "object"
              ]
            }
          },
          "required": [
            "item_type",
            "array"
          ]
        }
      ]
    },
    "tagObject": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "minProperties": 1,
      "type": "object"
    },
    "textItem": {
      "allOf": [
        {
          "$ref": "#/$defs/itemBase"
        },
        {
          "properties": {
            "item_type": {
              "const": "text"
            },
            "value": {
              "description": "Inline text or HTML payload, checked by the backend during item creation.",
              "type": [
                "string",
                "number",
                "boolean",
                "null",
                "array",
                "object"
              ]
            }
          },
          "required": [
            "item_type"
          ]
        }
      ]
    },
    "treeItem": {
      "allOf": [
        {
          "$ref": "#/$defs/itemBase"
        },
        {
          "properties": {
            "item_type": {
              "const": "tree"
            },
            "nodes": {
              "description": "Root nodes of the ADR tree, checked by the backend when the item is saved.",
              "items": {
                "$ref": "#/$defs/treeNode"
              },
              "type": "array"
            }
          },
          "required": [
            "item_type"
          ]
        }
      ]
    },
    "treeNode": {
      "additionalProperties": true,
      "properties": {
        "children": {
          "description": "Child nodes.",
          "items": {
            "$ref": "#/$defs/treeNode"
          },
          "type": "array"
        },
        "header": {
          "description": "Display the node row as a header.",
          "type": "boolean"
        },
        "key": {
          "description": "Entity type label; not displayed and need not be unique.",
          "type": "string"
        },
        "name": {
          "description": "Text displayed in the tree view.",
          "type": "string"
        },
        "state": {
          "description": "Initial display state of the node.",
          "enum": [
            "expanded",
            "collapsed",
            "expandRecursive",
            "collapseRecursive"
          ],
          "type": "string"
        },
        "value": {
          "description": "Node value: null, a scalar, or a possibly nested array of them.",
          "items": {
            "$ref": "#/$defs/treeNode/properties/value"
          },
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array"
          ]
        }
      },
      "required": [
        "key",
        "name",
        "value"
      ],
      "type": "object"
    }
