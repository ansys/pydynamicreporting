  "$id": "https://schemas.ansys.com/adr/item-import/1.0/adr-item-import.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "app_id": {
      "description": "Names the producing application and groups imported content.",
      "minLength": 1,
      "type": "string"
    },
    "items": {
      "description": "Report items to create.",
      "items": {
        "$ref": "#/$defs/item"
      },
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "description": "Import schema version, 'MAJOR.MINOR'.",
      "pattern": "^1\\.[0-9]+$",
      "type": "string"
    },
    "tags": {
      "description": "Tags applied to this object. Checked by the backend when each item is created.",
      "items": {
        "$ref": "#/$defs/tagObject"
      },
      "type": "array"
    }
  },
  "required": [
    "app_id"
  ],
  "title": "ADR Item Import Document",
  "type": "object"
